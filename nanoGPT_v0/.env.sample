# ── Data ──────────────────────────────────────────────────────────────────────
DATA_PATH=data/shakespeare.txt
TOKENIZER=char                  # char | bpe

# ── Model architecture ────────────────────────────────────────────────────────
BLOCK_SIZE=256
N_LAYER=6
N_HEAD=6
N_EMBED=384

# ── Training ──────────────────────────────────────────────────────────────────
MAX_STEPS=5000
BATCH_SIZE=64
MAX_LR=1e-3
MIN_LR=1e-4
WARMUP_STEPS=100
GRAD_CLIP=1.0
WEIGHT_DECAY=0.01
TRAIN_SPLIT=0.9

# ── Evaluation & logging ──────────────────────────────────────────────────────
EVAL_INTERVAL=100
EVAL_ITERS=20
SAMPLE_INTERVAL=500
CHECKPOINT_INTERVAL=1000
LOG_FILE=loss_log.json
CHECKPOINT_DIR=checkpoints

# ── Generation ────────────────────────────────────────────────────────────────
SAMPLE_PROMPT=To be or not
SAMPLE_MAX_NEW_TOKENS=100
SAMPLE_TEMPERATURE=0.8
SAMPLE_TOP_K=40
